<Window x:Class="SynnMods.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SynnMods"
        Title="Synn Mods" Width="1060" Height="720" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display">
    <Grid Background="{StaticResource Bg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Sidebar: brand + game list -->
        <Border Grid.RowSpan="2" Background="{StaticResource Side}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,20,16,16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,24">
                    <Border Width="34" Height="34" CornerRadius="9">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#C792FF" Offset="0" />
                                <GradientStop Color="#7B3FE4" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="S" FontSize="20" FontWeight="Bold" Foreground="#16101F"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Synn Mods" FontSize="17" FontWeight="Bold" />
                        <TextBlock Text="{Binding AppVersionText}" FontSize="11" Foreground="{StaticResource Muted}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Border Background="{StaticResource PanelHi}" CornerRadius="8" Padding="12" Margin="0,0,0,10"
                            Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding UpdateText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <Button Content="Update and restart" Style="{StaticResource Primary}" Click="ApplyUpdate_Click"
                                    IsEnabled="{Binding IsIdle}" />
                        </StackPanel>
                    </Border>
                    <Button Content="Refresh" Click="Refresh_Click" IsEnabled="{Binding IsIdle}" />
                    <TextBlock Text="{Binding CatalogSource}" FontSize="11" Foreground="{StaticResource Muted}"
                               TextWrapping="Wrap" Margin="2,10,0,0" />
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="GAMES" Style="{StaticResource SectionTitle}" Margin="4,0,0,8" />
                    <ListBox ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}"
                             Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource GameItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="local:GameViewModel">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="28" Height="28" CornerRadius="6" Background="{StaticResource Bg}">
                                        <TextBlock Text="{Binding Initial}" FontWeight="Bold" Foreground="{StaticResource AccentHi}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{Binding LoadError}" Foreground="{StaticResource Bad}" TextWrapping="Wrap" Margin="4,8,0,0"
                               Visibility="{Binding HasLoadError, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main area: the selected game -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" DataContext="{Binding SelectedGame}">
            <StackPanel Margin="32,28,32,24">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <TextBlock Text="{Binding Name}" FontSize="28" FontWeight="Bold" />
                <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" Margin="0,4,0,0" FontSize="14" />

                <!-- Multiplayer notice -->
                <Border Background="{StaticResource WarnBg}" BorderBrush="{StaticResource Warn}" BorderThickness="1"
                        CornerRadius="8" Padding="14,10" Margin="0,18,0,0"
                        Visibility="{Binding HasNotice, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                   Foreground="{StaticResource Warn}" Margin="0,1,10,0" VerticalAlignment="Top" />
                        <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" />
                    </DockPanel>
                </Border>

                <!-- Install location -->
                <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                    <StackPanel>
                        <TextBlock Text="INSTALL TO" Style="{StaticResource SectionTitle}" />
                        <ItemsControl ItemsSource="{Binding Targets}" Margin="0,0,0,12"
                                      Visibility="{Binding HasMultipleTargets, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="local:TargetViewModel">
                                    <RadioButton Style="{StaticResource Segment}" IsChecked="{Binding IsSelected}"
                                                 GroupName="{Binding DataContext.Name, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                 ToolTip="{Binding Description}" Checked="Target_Checked">
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,8"
                                   Text="{Binding SelectedTarget.Description}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Open" Margin="8,0,0,0" Click="OpenFolder_Click"
                                    ToolTip="Open the Mods folder in File Explorer" />
                            <Button DockPanel.Dock="Right" Content="Find in Steam" Margin="8,0,0,0" Click="Detect_Click"
                                    ToolTip="Look for the game in your Steam libraries" />
                            <Button DockPanel.Dock="Right" Content="Browse…" Margin="8,0,0,0" Click="Browse_Click" />
                            <TextBox x:Name="PathBox" Text="{Binding SelectedTarget.Path, UpdateSourceTrigger=Explicit}"
                                     LostKeyboardFocus="PathBox_LostFocus" KeyDown="PathBox_KeyDown" />
                        </DockPanel>
                        <TextBlock Text="{Binding PathMessage}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PathOk}" Value="False">
                                            <Setter Property="Foreground" Value="{StaticResource Bad}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Mods -->
                <DockPanel Margin="0,26,0,10">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Install / update all" Style="{StaticResource Primary}" Click="InstallAll_Click"
                                IsEnabled="{Binding DataContext.IsIdle, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </StackPanel>
                    <TextBlock Text="MODS" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0" />
                </DockPanel>

                <TextBlock Text="Loading mods…" Style="{StaticResource MutedText}"
                           Visibility="{Binding ModsLoading, Converter={StaticResource BoolToVis}}" />
                <Border Background="{StaticResource BadBg}" CornerRadius="8" Padding="14,10" Margin="0,0,0,10"
                        Visibility="{Binding HasModsError, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ModsError}" TextWrapping="Wrap" />
                </Border>

                <ItemsControl ItemsSource="{Binding Mods}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="local:ModViewModel">
                            <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="250" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Margin="0,0,16,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock x:Name="Status" Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold"
                                                       Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding RequiredOnText}" FontSize="11" Foreground="{StaticResource AccentHi}" Margin="0,6,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock FontSize="12" Foreground="{StaticResource Muted}">
                                            <Run Text="Latest: " /><Run Text="{Binding AvailableVersion, Mode=OneWay}" Foreground="{StaticResource Text}" />
                                        </TextBlock>
                                        <TextBlock FontSize="12" Foreground="{StaticResource Muted}" Margin="0,2,0,0">
                                            <Run Text="Installed: " /><Run Text="{Binding InstalledVersionText, Mode=OneWay}" Foreground="{StaticResource Text}" />
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <Button Content="Remove" Style="{StaticResource Danger}" Click="Remove_Click" Margin="0,0,6,0"
                                                Visibility="{Binding CanRemove, Converter={StaticResource BoolToVis}}"
                                                IsEnabled="{Binding DataContext.IsIdle, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        <Button x:Name="Action" Content="{Binding ActionText}" Click="Install_Click" MinWidth="110"
                                                Visibility="{Binding CanInstall, Converter={StaticResource BoolToVis}}"
                                                IsEnabled="{Binding DataContext.IsIdle, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding StatusKind}" Value="good">
                                    <Setter TargetName="Status" Property="Foreground" Value="{StaticResource Good}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusKind}" Value="warn">
                                    <Setter TargetName="Status" Property="Foreground" Value="{StaticResource Warn}" />
                                    <Setter TargetName="Action" Property="Style" Value="{StaticResource Primary}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="NotInstalled">
                                    <Setter TargetName="Action" Property="Style" Value="{StaticResource Primary}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Status bar -->
        <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource Side}" BorderBrush="{StaticResource Line}"
                BorderThickness="0,1,0,0" Padding="32,10">
            <StackPanel>
                <TextBlock Text="{Binding Status}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                <ProgressBar Margin="0,6,0,0" Value="{Binding Progress}" Maximum="1"
                             IsIndeterminate="{Binding ProgressIndeterminate}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
