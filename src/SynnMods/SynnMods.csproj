<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>SynnMods</RootNamespace>
    <AssemblyName>SynnMods</AssemblyName>
    <StartupObject>SynnMods.Program</StartupObject>
    <ApplicationIcon>..\..\assets\synnmods.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- build.ps1 overrides this with -p:Version=x.y.z -->
    <Version>0.1.0</Version>
    <Product>Synn Mods</Product>
    <Company>Synn</Company>
    <Description>Installs and updates game mods from the Synn Mods catalog.</Description>
    <Copyright>Synn</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!-- App.xaml is a normal page so Program.Main can run Velopack's startup hooks first. -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

</Project>
